          <mxGeometry x="35" y="60" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ng" value="Managed node group &quot;demo-node-group&quot;&#10;t3.small · capacity_type = SPOT&#10;desired 5 / min 1 / max 6&#10;Nodes only in private subnets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="priv">
          <mxGeometry x="140" y="55" width="280" height="105" as="geometry" />
        </mxCell>
        <mxCell id="workloads" value="namespace: petclinic&#10;api-gateway :8080 (Argo Rollout — canary 20% → analysis → promote)&#10;discovery-server :8761 · config-server :8888&#10;customers :8081 · visits :8082 · vets :8083 · genai :8084&#10;&#10;namespace: monitoring — kube-prometheus-stack (Prometheus + Grafana)&#10;namespace: kube-system — ALB controller, VPC CNI, CoreDNS,&#10;eks-pod-identity-agent, amazon-cloudwatch-observability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="priv">
          <mxGeometry x="440" y="55" width="490" height="180" as="geometry" />
        </mxCell>
        <mxCell id="cninote" value="VPC CNI gives every pod&#10;a real VPC IP from&#10;10.0.1-3.0/24.&#10;&#10;t3.small = 11 pods/node&#10;→ IP pressure is the&#10;real scaling limit here." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6F6;strokeColor=#CD2264;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="priv">
          <mxGeometry x="950" y="55" width="200" height="180" as="geometry" />
        </mxCell>

        <mxCell id="rds" value="RDS MySQL 8.0" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#3334B9;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="priv">
          <mxGeometry x="35" y="300" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rdsbox" value="db.t4g.micro · 20 GB · multi_az = false · publicly_accessible = false&#10;DB subnet group spans the 3 private subnets&#10;SG: ingress 3306 from 10.0.0.0/16 (VPC CIDR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3334B9;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="priv">
          <mxGeometry x="140" y="300" width="490" height="80" as="geometry" />
        </mxCell>
        <mxCell id="privrt" value="Private RTs ×3 (one per subnet)&#10;0.0.0.0/0 → the single NAT GW in AZ-1a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;fontSize=11;dashed=1;" vertex="1" parent="priv">
          <mxGeometry x="660" y="300" width="490" height="80" as="geometry" />
        </mxCell>

        <mxCell id="tradeoffs" value="Deliberate trade-offs (cost over resilience — this is a portfolio/demo account)&#10;• 1 NAT GW instead of 3: saves ~$65/mo, but AZ-1a is a single point of failure for all egress and cross-AZ NAT data is charged.&#10;• RDS single-AZ + SPOT nodes: cheapest viable; production would be Multi-AZ and ON_DEMAND (or mixed) capacity.&#10;• SG opens 3306 to the whole VPC CIDR rather than the node SG — the tighter fix is source_security_group_id = eks node SG.&#10;• EKS public endpoint enabled with public_access_cidrs = 0.0.0.0/0 so GitHub-hosted runners can reach it; the self-hosted runner exists to allow locking this down to private-only.&#10;• No VPC endpoints — all ECR/S3/STS pulls traverse the NAT GW and incur data-processing charges. S3 + ECR gateway/interface endpoints are the next optimisation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBF0;strokeColor=#ED7100;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="region">
          <mxGeometry x="30" y="900" width="1360" height="110" as="geometry" />
        </mxCell>

