                <mxCell id="x5" value="TCP 80" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8E24AA;fontSize=11;" parent="21" source="sg3" target="sg4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="Notes&#xa;• Service maps 8080 → 8080 (kubernetes/api-gateway/service.yaml)&#xa;• ALB target-type = ip, so the ALB registers Pod IPs directly (no NodePort hop)&#xa;• Ingress has no certificate/listener-ports annotation → public listener is HTTP 80, not 443&#xa;• Rules are created dynamically by the AWS Load Balancer Controller, not hand-written" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=12;spacing=8;" parent="21" vertex="1">
                    <mxGeometry x="60" y="520" width="800" height="120" as="geometry"/>
                </mxCell>
