                    <mxGeometry x="280" y="150" width="230" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="sg2" value="Node / Pod Security Group&#xa;(EKS worker nodes)&#xa;&#xa;INBOUND: TCP 8080&#xa;SOURCE: ALB SG only&#xa;(not a CIDR — SG reference)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;verticalAlign=top;" parent="21" vertex="1">
