                <mxCell id="x3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6C8EBF;" parent="21" source="sg2" target="pod" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="x4" value="HTTP 80" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D79B00;fontSize=11;dashed=1;" parent="21" source="i" target="sg3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
