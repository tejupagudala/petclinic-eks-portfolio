                    <mxGeometry x="930" y="185" width="130" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="sg3" value="Argo CD ALB SG&#xa;INBOUND: TCP 80 from 0.0.0.0/0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" parent="21" vertex="1">
                    <mxGeometry x="280" y="380" width="230" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="sg4" value="Argo CD Service SG&#xa;INBOUND: TCP 80 from Argo ALB SG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=12;" parent="21" vertex="1">
                    <mxGeometry x="610" y="380" width="250" height="80" as="geometry"/>
