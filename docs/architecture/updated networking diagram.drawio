<mxfile host="65bd71144e">
    <diagram id="flow" name="1. Traffic Flow (simple)">
        <mxGraphModel dx="1795" dy="947" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Petclinic — how traffic flows" style="text;html=1;fontSize=24;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="50" y="25" width="700" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="sub" value="Follow the numbers. Public subnets hold only the load balancer and the NAT — everything else is private." style="text;html=1;fontSize=14;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="50" y="60" width="900" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="users" value="Internet Users" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="60" y="240" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="docker" value="Docker Hub&#xa;container images" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="60" y="620" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="vpc" value="VPC   10.0.0.0/16   •   us-east-1   •   3 AZs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=3;verticalAlign=top;fontStyle=1;fontSize=18;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="320" y="110" width="1160" height="810" as="geometry"/>
                </mxCell>
                <mxCell id="pub" value="PUBLIC SUBNETS  (one per AZ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=15;fontStyle=1;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="350" y="165" width="1100" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="igw" value="Internet Gateway" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="380" y="220" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="alb" value="Application Load Balancer&#xa;listener HTTP :80&#xa;(one for Petclinic, one for Argo CD)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="660" y="215" width="330" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="nat" value="NAT Gateway&#xa;single, in us-east-1a&#xa;outbound only" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="1130" y="215" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="priv" value="PRIVATE SUBNETS  (one per AZ)   —   no public IPs, unreachable from the internet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=15;fontStyle=1;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="350" y="395" width="1100" height="490" as="geometry"/>
                </mxCell>
                <mxCell id="eks" value="EKS worker nodes   (spot t3.small, spread across the 3 AZs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="380" y="440" width="1040" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="gw" value="api-gateway Pods&#xa;TCP :8080&#xa;the only entry point" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="410" y="500" width="260" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="svc" value="Backend Pods&#xa;customers :8081&#xa;visits :8082&#xa;vets :8083" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="790" y="490" width="250" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="argo" value="Argo CD Service&#xa;:80" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="1160" y="505" width="230" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="rds" value="RDS MySQL   :3306&#xa;private, no public access" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="790" y="750" width="330" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="cp" value="EKS Control Plane&#xa;AWS-managed&#xa;(outside your VPC)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="1550" y="480" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="f1" value="1   HTTP :80" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#82b366;fontSize=14;fontStyle=1" parent="1" source="users" target="igw" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f2" value="2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#82b366;fontSize=14;fontStyle=1" parent="1" source="igw" target="alb" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f3" value="3   TCP :8080 straight to the Pod IP" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#82b366;fontSize=14;fontStyle=1" parent="1" source="alb" target="gw" edge="1">
                    <mxGeometry x="-0.234" y="-10" relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="825" y="370"/>
                            <mxPoint x="540" y="370"/>
                        </Array>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="f4" value="4   internal call by service name" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#6c8ebf;fontSize=14;" parent="1" source="gw" target="svc" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f5" value="5   MySQL :3306" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#b85450;fontSize=14;" parent="1" source="svc" target="rds" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f6" value="Argo CD ALB rule → :80" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#d6b656;fontSize=13;" parent="1" source="alb" target="argo" edge="1">
                    <mxGeometry x="0.219" y="75" relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1275" y="290"/>
                        </Array>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="g1" value="outbound only" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#d6b656;dashed=1;fontSize=13;" parent="1" source="eks" target="nat" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#d6b656;dashed=1;" parent="1" source="nat" target="igw" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g3" value="image pulls" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#d6b656;dashed=1;fontSize=13;" parent="1" source="igw" target="docker" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g4" value="nodes register" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#999999;dashed=1;fontSize=13;" parent="1" source="eks" target="cp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="Solid = user traffic (steps 1-5)          Dashed = everything else (egress, image pulls, control plane)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=left;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="320" y="940" width="1160" height="45" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="details" name="2. Details (SGs, routes, gaps)">
        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="10"/>
                <mxCell id="11" parent="10"/>
                <mxCell id="dt" value="The details behind the flow" style="text;html=1;fontSize=22;fontStyle=1;" vertex="1" parent="11">
                    <mxGeometry x="50" y="25" width="600" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="sg" value="SECURITY GROUPS — who is allowed to talk&#xa;(created dynamically by the AWS Load Balancer Controller)&#xa;&#xa;Petclinic ALB&#xa;   inbound TCP 80 from 0.0.0.0/0&#xa;&#xa;Pod network&#xa;   inbound TCP 8080 from the Petclinic ALB SG only&#xa;&#xa;Argo CD ALB&#xa;   inbound TCP 80 from 0.0.0.0/0&#xa;&#xa;Argo CD service&#xa;   inbound TCP 80 from the Argo CD ALB SG only&#xa;&#xa;RDS&#xa;   MySQL 3306 from inside the VPC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=14;spacing=12;" vertex="1" parent="11">
                    <mxGeometry x="50" y="90" width="420" height="440" as="geometry"/>
                </mxCell>
                <mxCell id="rtn" value="ROUTE TABLES — where traffic goes&#xa;&#xa;Public subnets&#xa;   10.0.0.0/16  →  local&#xa;   0.0.0.0/0    →  Internet Gateway&#xa;&#xa;Private subnets&#xa;   10.0.0.0/16  →  local&#xa;   0.0.0.0/0    →  NAT Gateway (us-east-1a)&#xa;&#xa;Inside the VPC (ALB → Pod, Pod → RDS)&#xa;traffic stays on the local route and never&#xa;touches the NAT or the Internet Gateway.&#xa;&#xa;Inbound user traffic never goes through NAT.&#xa;NAT is for outbound only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=14;spacing=12;" vertex="1" parent="11">
                    <mxGeometry x="500" y="90" width="420" height="440" as="geometry"/>
                </mxCell>
                <mxCell id="mem" value="TWO WORDS THAT ARE EASY TO MIX UP&#xa;&#xa;Route table&#xa;   WHERE traffic can go&#xa;&#xa;Security group&#xa;   WHETHER traffic is allowed&#xa;&#xa;Both must say yes for a packet to arrive." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=14;spacing=12;" vertex="1" parent="11">
                    <mxGeometry x="950" y="90" width="380" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="gaps" value="KNOWN GAPS — say these before an interviewer finds them&#xa;&#xa;•  No TLS. Listeners are HTTP :80, no ACM certificate. Argo CD login&#xa;   credentials would cross the internet in plaintext.&#xa;&#xa;•  Single NAT Gateway in us-east-1a. Cost choice (~$32/mo each).&#xa;   If 1a fails, private subnets in 1b and 1c lose outbound internet.&#xa;&#xa;•  EKS public endpoint open to 0.0.0.0/0. Should be restricted to&#xa;   known CIDRs, or made private-only.&#xa;&#xa;•  RDS is Single-AZ. No automatic failover.&#xa;&#xa;•  No VPC endpoints. S3 and ECR traffic pays NAT data charges;&#xa;   a Gateway Endpoint for S3 is free.&#xa;&#xa;•  Argo CD ALB is internet-facing. An admin console should be internal&#xa;   or behind a VPN." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=14;spacing=12;" vertex="1" parent="11">
                    <mxGeometry x="50" y="570" width="870" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="adm" value="ADMIN PATH&#xa;&#xa;GitHub Actions and your laptop reach&#xa;the EKS control plane over the public&#xa;cluster endpoint, authenticated with&#xa;IAM plus an EKS access entry.&#xa;&#xa;This is separate from user traffic —&#xa;it does not go through the ALB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=14;spacing=12;" vertex="1" parent="11">
                    <mxGeometry x="950" y="380" width="380" height="240" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>