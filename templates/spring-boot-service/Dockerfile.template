FROM eclipse-temurin:17-jdk AS builder

WORKDIR /workspace

COPY . .

RUN chmod +x mvnw

RUN ./mvnw \
    -pl spring-petclinic-__SERVICE_NAME__ \
    -am \
    package \
    -DskipTests


FROM eclipse-temurin:17-jre

WORKDIR /app

COPY --from=builder \
    /workspace/spring-petclinic-__SERVICE_NAME__/target/*.jar \
    /app/app.jar

EXPOSE __PORT__

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
